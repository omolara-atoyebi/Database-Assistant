# Copy to .env (never commit .env). Pick one provider.

# Local and offline (the default): Ollama's Anthropic-compatible API.
# One-time setup:
#   ollama pull qwen3:14b
#   ollama create qwen3-14b-16k -f ollama/Modelfile
LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3-14b-16k

# Claude via the Anthropic API (needs internet):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5
